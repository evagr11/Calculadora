<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="530.0" prefWidth="340.0" spacing="10.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.CalculadoraController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label fx:id="pantalla" alignment="CENTER_RIGHT" maxWidth="Infinity" prefHeight="100.0" style="-fx-text-fill: #FFFFFF; -fx-font-size: 48px; -fx-padding: 0 8 0 0;" text="0" />

      <GridPane hgap="10.0" vgap="10.0">
         <columnConstraints>
            <ColumnConstraints prefWidth="70.0" />
            <ColumnConstraints prefWidth="70.0" />
            <ColumnConstraints prefWidth="70.0" />
            <ColumnConstraints prefWidth="70.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints prefHeight="70.0" />
            <RowConstraints prefHeight="70.0" />
            <RowConstraints prefHeight="70.0" />
            <RowConstraints prefHeight="70.0" />
            <RowConstraints prefHeight="70.0" />
         </rowConstraints>
         <children>
            <!-- Fila 0: C (ocupa tres columnas) y dividir -->
            <Button text="C" prefWidth="230" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarBorrar" style="-fx-background-color: #A5A5A5; -fx-text-fill: #000000; -fx-font-size: 28px; -fx-background-radius: 35;" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="3" />
            <Button text="÷" prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarOperacion" style="-fx-background-color: #FF9F0A; -fx-text-fill: #FFFFFF; -fx-font-size: 32px; -fx-background-radius: 35;" userData="/" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <!-- Fila 1: 7 8 9 × (mismo orden que el prototipo) -->
            <Button text="7" prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarNumero" style="-fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-font-size: 28px; -fx-background-radius: 35;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Button text="8" prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarNumero" style="-fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-font-size: 28px; -fx-background-radius: 35;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Button text="9" prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarNumero" style="-fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-font-size: 28px; -fx-background-radius: 35;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Button text="×" prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarOperacion" style="-fx-background-color: #FF9F0A; -fx-text-fill: #FFFFFF; -fx-font-size: 32px; -fx-background-radius: 35;" userData="*" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <!-- Fila 2: 4 5 6 − -->
            <Button text="4" prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarNumero" style="-fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-font-size: 28px; -fx-background-radius: 35;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Button text="5" prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarNumero" style="-fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-font-size: 28px; -fx-background-radius: 35;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Button text="6" prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarNumero" style="-fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-font-size: 28px; -fx-background-radius: 35;" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <Button text="−" prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarOperacion" style="-fx-background-color: #FF9F0A; -fx-text-fill: #FFFFFF; -fx-font-size: 32px; -fx-background-radius: 35;" userData="-" GridPane.columnIndex="3" GridPane.rowIndex="2" />

            <!-- Fila 3: 1 2 3 + -->
            <Button text="1" prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarNumero" style="-fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-font-size: 28px; -fx-background-radius: 35;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Button text="2" prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarNumero" style="-fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-font-size: 28px; -fx-background-radius: 35;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Button text="3" prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarNumero" style="-fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-font-size: 28px; -fx-background-radius: 35;" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <Button text="+" prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarOperacion" style="-fx-background-color: #FF9F0A; -fx-text-fill: #FFFFFF; -fx-font-size: 32px; -fx-background-radius: 35;" userData="+" GridPane.columnIndex="3" GridPane.rowIndex="3" />

            <!-- Fila 4: 0 (doble) . = -->
            <Button text="0" prefWidth="150" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarNumero" style="-fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-font-size: 28px; -fx-background-radius: 35;" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2" />
            <Button text="." prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarPunto" style="-fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-font-size: 28px; -fx-background-radius: 35;" GridPane.columnIndex="2" GridPane.rowIndex="4" />
            <Button text="=" prefWidth="70" prefHeight="70" mnemonicParsing="false" focusTraversable="false" onAction="#pulsarIgual" style="-fx-background-color: #FF9F0A; -fx-text-fill: #FFFFFF; -fx-font-size: 32px; -fx-background-radius: 35;" GridPane.columnIndex="3" GridPane.rowIndex="4" />
         </children>
      </GridPane>
   </children>
</VBox>
